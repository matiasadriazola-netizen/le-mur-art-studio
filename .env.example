# URL pública del sitio (Webpay vuelve aquí después del pago)
# En producción: APP_URL=https://www.lemurstudio.cl
APP_URL=http://localhost:3000

# Base de datos. En desarrollo SQLite; en producción se recomienda PostgreSQL.
DATABASE_URL="file:./dev.db"

# Panel de administración
ADMIN_PASSWORD=cambia-esta-clave
SESSION_SECRET=una-cadena-larga-y-aleatoria-de-al-menos-32-caracteres

# Webpay Plus
# integration = ambiente de pruebas de Transbank (usa las credenciales públicas de prueba)
# production  = pagos reales (requiere la llave secreta que entrega Transbank tras validar)
WEBPAY_ENV=integration
WEBPAY_COMMERCE_CODE=597052992296
WEBPAY_API_KEY=

# Clave para llamar /api/cron desde un programador de tareas
CRON_SECRET=otra-cadena-aleatoria
