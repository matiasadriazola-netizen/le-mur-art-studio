{
  "name": "le-mur-art-studio",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:dev": "node scripts/dev-schema.mjs && prisma db push --schema prisma/dev.schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "npm run db:dev && npm run db:seed",
    "db:prod": "prisma generate && prisma db push",
    "test": "tsx --test src/lib/*.test.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "jose": "5.10.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "transbank-sdk": "6.1.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "prisma": "6.19.3",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
